@model IEnumerable<DoAnCNPM.Models.OrderDetail>

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>DANH SÁCH CHI TIẾT ĐƠN HÀNG</h2>

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-bordered" style="border-width: thick; width: 100%;">
    <thead>
        <tr>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Địa chỉ giao hàng</th>
            <th>Tên sản phẩm</th>
            <th style="text-align: center;">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                <td>@Html.DisplayFor(modelItem => item.UnitPrice)</td>
                <td>@Html.DisplayFor(modelItem => item.OrderPro.AddressDeliverry)</td>
                <td>@Html.DisplayFor(modelItem => item.Product.NamePro)</td>
                <td style="text-align: center;">
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.ID }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ID }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ID })
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <!-- Nếu không có script riêng thì để trống -->
}
