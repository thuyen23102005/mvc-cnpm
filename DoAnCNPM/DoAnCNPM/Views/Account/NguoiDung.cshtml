@model DoAnCNPM.Models.Customer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var orders = ViewBag.OrderHistory as List<DoAnCNPM.Models.OrderPro>;
}

<div class="container mt-4">
    <div class="row">
        <!-- Cột trái: Thông tin người dùng -->
        <div class="col-md-6">
            <h3>Thông Tin Người Dùng</h3>

            @using (Html.BeginForm("CapNhatNguoiDung", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IDCus)

                <div class="form-group">
                    <label>Tên đăng nhập:</label>
                    @Html.DisplayFor(m => m.UserName)
                </div>

                <div class="form-group">
                    <label>Họ tên:</label>
                    @Html.TextBoxFor(m => m.NameCus, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.NameCus, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Số điện thoại:</label>
                    @Html.TextBoxFor(m => m.PhoneCus, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.PhoneCus, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Email:</label>
                    @Html.TextBoxFor(m => m.EmailCus, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.EmailCus, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Địa chỉ giao hàng:</label>
                    @Html.TextBox("AddressDeliverry", ViewBag.AddressDelivery as string, new
                    {
                        @class = "form-control",
                        placeholder = "Nhập địa chỉ nhận hàng..."
                    })
                </div>

                <button type="submit" class="btn btn-primary mt-2">Lưu</button>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success mt-3">
                    @TempData["Success"]
                </div>
            }
        </div>

        <!-- Cột phải: Lịch sử đơn hàng -->
        <div class="col-md-6">
            <h3>Lịch sử đơn hàng</h3>

            @if (orders != null && orders.Any())
            {
                <table class="table table-bordered">
                    <tr>
                        <th>Ngày đặt</th>
                        <th>Địa chỉ</th>
                        <th></th>
                    </tr>
                    @foreach (var order in orders)
                    {
                        <tr>
                            <td>@(order.DateOrder?.ToString("dd/MM/yyyy"))</td>
                            <td>@order.AddressDeliverry</td>
                            <td>
                                <button class="btn btn-sm btn-info btn-chi-tiet" data-id="@order.ID">Chi tiết</button>
                            </td>
                        </tr>
                    }
                </table>
            }
            else
            {
                <p>Bạn chưa có đơn hàng nào.</p>
            }
        </div>

        <!-- Chi tiết hóa đơn -->
        <div class="modal fade" id="modalChiTiet" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">🧾 Chi tiết đơn hàng</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p><strong>Ngày đặt:</strong> <span id="ct-ngay"></span></p>
                        <p><strong>Địa chỉ:</strong> <span id="ct-diachi"></span></p>

                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>SL</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody id="ct-danhsach"></tbody>
                        </table>

                        <h5 class="text-end">Tổng cộng: <span class="text-danger" id="ct-tong"></span></h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/popupCT.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
}