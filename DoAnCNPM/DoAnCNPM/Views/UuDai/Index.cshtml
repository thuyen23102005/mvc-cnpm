@model IEnumerable<DoAnCNPM.Models.Coupon>

@{
    ViewBag.Title = "Quản lý mã giảm giá";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Quản lý mã giảm giá</h3>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Thêm mã giảm giá
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Form tìm kiếm và lọc -->
                    <div class="row mb-4">
                        <div class="col-md-8">
                            @using (Html.BeginForm("Index", "UuDai", FormMethod.Get))
                            {
                                <div class="input-group">
                                    <input type="text" name="searchString" class="form-control" 
                                           placeholder="Tìm kiếm theo mã hoặc mô tả..." 
                                           value="@ViewBag.SearchString">
                                    <button class="btn btn-outline-secondary" type="submit">
                                        <i class="fas fa-search"></i> Tìm kiếm
                                    </button>
                                    @if (!string.IsNullOrEmpty(ViewBag.SearchString))
                                    {
                                        <a href="@Url.Action("Index", new { statusFilter = ViewBag.StatusFilter })" 
                                           class="btn btn-outline-danger">
                                            <i class="fas fa-times"></i> Xóa
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-4">
                            @using (Html.BeginForm("Index", "UuDai", FormMethod.Get))
                            {
                                <input type="hidden" name="searchString" value="@ViewBag.SearchString" />
                                <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="active" @(ViewBag.StatusFilter == "active" ? "selected" : "")>Đang hoạt động</option>
                                    <option value="inactive" @(ViewBag.StatusFilter == "inactive" ? "selected" : "")>Không hoạt động</option>
                                    <option value="expired" @(ViewBag.StatusFilter == "expired" ? "selected" : "")>Đã hết hạn</option>
                                    <option value="not_started" @(ViewBag.StatusFilter == "not_started" ? "selected" : "")>Chưa bắt đầu</option>
                                    <option value="used_up" @(ViewBag.StatusFilter == "used_up" ? "selected" : "")>Đã hết lượt</option>
                                </select>
                            }
                        </div>
                    </div>

                    <!-- Thống kê nhanh -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.Count()</h5>
                                    <small>Tổng số mã</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.Count(c => c.IsActive && DateTime.Now >= c.StartDate && DateTime.Now <= c.EndDate && c.UsedQuantity < c.Quantity)</h5>
                                    <small>Đang hoạt động</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.Count(c => DateTime.Now > c.EndDate)</h5>
                                    <small>Đã hết hạn</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-danger text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.Count(c => c.UsedQuantity >= c.Quantity)</h5>
                                    <small>Hết lượt</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Mã</th>
                                    <th>Mô tả</th>
                                    <th>Loại giảm giá</th>
                                    <th>Giá trị</th>
                                    <th>Đơn hàng tối thiểu</th>
                                    <th>Số lượng</th>
                                    <th>Đã sử dụng</th>
                                    <th>Ngày hiệu lực</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="10" class="text-center">
                                            <div class="alert alert-info">
                                                <i class="fas fa-info-circle"></i> Không tìm thấy mã giảm giá nào.
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary fs-6">@item.Code</span>
                                            </td>
                                            <td>@item.Description</td>
                                            <td>
                                                @if (item.DiscountType == "Percentage")
                                                {
                                                    <span class="badge bg-info">Phần trăm</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Cố định</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.DiscountType == "Percentage")
                                                {
                                                    <span class="text-success fw-bold">@item.DiscountValue%</span>
                                                }
                                                else
                                                {
                                                    <span class="text-success fw-bold">@item.DiscountValue.ToString("N0") VNĐ</span>
                                                }
                                            </td>
                                            <td>@item.MinimumOrderValue.ToString("N0") VNĐ</td>
                                            <td>@item.Quantity</td>
                                            <td>
                                                <span class="@(item.UsedQuantity >= item.Quantity ? "text-danger" : "text-success")">
                                                    @item.UsedQuantity
                                                </span>
                                            </td>
                                            <td>
                                                <small>
                                                    @item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                @{
                                                    var now = DateTime.Now.Date;
                                                    var isValid = item.IsActive && 
                                                                 now >= item.StartDate && 
                                                                 now <= item.EndDate && 
                                                                 item.UsedQuantity < item.Quantity;
                                                }
                                                @if (isValid)
                                                {
                                                    <span class="badge bg-success">Hoạt động</span>
                                                }
                                                else if (now > item.EndDate)
                                                {
                                                    <span class="badge bg-danger">Hết hạn</span>
                                                }
                                                else if (now < item.StartDate)
                                                {
                                                    <span class="badge bg-warning">Chưa bắt đầu</span>
                                                }
                                                else if (item.UsedQuantity >= item.Quantity)
                                                {
                                                    <span class="badge bg-secondary">Hết lượt</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Không hoạt động</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Auto hide alerts after 5 seconds
            setTimeout(function () {
                $('.alert').fadeOut('slow');
            }, 5000);
        });
    </script>
} 