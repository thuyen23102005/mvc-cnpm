@model IEnumerable<DoAnCNPM.Models.OrderPro>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>DANH SÁCH ĐƠN HÀNG</h2>

<p>
    @Html.ActionLink("Tạo Đơn Hàng Mới", "Create", null, new { @class = "btn btn-success" })
</p>
<table  class="table table-bordered" style="border-width:thick">
    <tr>
        <th>
            Ngày Giao Hàng
        </th>
        <th>
            Địa Chỉ Giao Hàng
        </th>
        <th>
            Khách Hàng
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.DateOrder)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AddressDeliverry)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Customer.NameCus)
        </td>
        <td>
            @Html.ActionLink("Cập Nhật", "Edit", new { id=item.ID }) |
            @Html.ActionLink("Chi Tiết", "Details", new { id=item.ID }) |
            @Html.ActionLink("Xóa", "Delete", new { id=item.ID })
        </td>
    </tr>
}

</table>
