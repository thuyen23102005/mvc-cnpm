@model DoAnCNPM.Models.OrderPro

@{
    ViewBag.Title = "Tạo đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>TẠO ĐƠN HÀNG</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div style="max-width: 600px;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Ngày đặt hàng -->
        <div class="form-group" style="display: flex; margin-bottom: 15px;">
            <label style="width: 180px; font-weight: bold;">Ngày đặt hàng:</label>
            <div style="flex: 1;">
                @Html.EditorFor(model => model.DateOrder, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.DateOrder, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Khách hàng -->
        <div class="form-group" style="display: flex; margin-bottom: 15px;">
            <label style="width: 180px; font-weight: bold;">Khách hàng:</label>
            <div style="flex: 1;">
                @Html.DropDownList("IDCus", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.IDCus, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Địa chỉ giao hàng -->
        <div class="form-group" style="display: flex; margin-bottom: 15px;">
            <label style="width: 180px; font-weight: bold;">Địa chỉ giao hàng:</label>
            <div style="flex: 1;">
                @Html.EditorFor(model => model.AddressDeliverry, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.AddressDeliverry, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Nút tạo đơn -->
        <div class="form-group" style="margin-top: 30px;">
            <input type="submit" value="Tạo đơn hàng" class="btn btn-success" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary", style = "margin-left: 10px;" })
        </div>
    </div>
}
