@model List<DoAnCNPM.Models.CartItem>
@{
    ViewBag.Title = "Giỏ Hàng Circle K";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-4">🛒 Giỏ Hàng Của Bạn - Circle K</h2>

    @if (!Model.Any())
    {
        <p>Giỏ hàng của bạn đang trống.</p>
    }
    else
    {
        <form method="post" action="/GioHang/CapNhatGioHang">
            <table class="table table-bordered align-middle">
                <thead class="thead-light">
                    <tr>
                        <th><input type="checkbox" /></th>
                        <th>Sản Phẩm</th>
                        <th>Đơn Giá</th>
                        <th>Số Lượng</th>
                        <th>Thành Tiền</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" name="chon[]" value="@Model[i].Id" />
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@Model[i].HinhAnh" alt="@Model[i].Ten" width="60" class="me-3 border" />
                                    <div>
                                        <strong>@Model[i].Ten</strong>
                                    </div>
                                </div>
                            </td>
                            <td>@Model[i].DonGia.ToString("N0") ₫</td>
                            <td>
                                <div class="input-group" style="max-width: 120px;">
                                    <button class="btn btn-outline-secondary btn-minus" type="button">-</button>
                                    <input type="text" name="SoLuong[@i]" value="@Model[i].SoLuong" class="form-control text-center" />
                                    <button class="btn btn-outline-secondary btn-plus" type="button">+</button>
                                </div>
                            </td>
                            <td class="text-danger">@Model[i].ThanhTien.ToString("N0") ₫</td>
                            <td>
                                <a href="/GioHang/Xoa/@Model[i].Id" class="text-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="text-end mt-3">
                <h5>
                    Tổng cộng:
                    <strong class="text-danger">
                        @Model.Sum(item => item.ThanhTien).ToString("N0") ₫
                    </strong>
                </h5>
                <button type="submit" class="btn btn-primary mt-2">🛍️ Mua Hàng</button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        // Tăng số lượng
        document.querySelectorAll(".btn-plus").forEach(function (btn) {
            btn.addEventListener("click", function () {
                let input = this.closest(".input-group").querySelector("input");
                let value = parseInt(input.value);
                if (!isNaN(value)) {
                    input.value = value + 1;
                }
            });
        });

        // Giảm số lượng
        document.querySelectorAll(".btn-minus").forEach(function (btn) {
            btn.addEventListener("click", function () {
                let input = this.closest(".input-group").querySelector("input");
                let value = parseInt(input.value);
                if (!isNaN(value) && value > 1) {
                    input.value = value - 1;
                }
            });
        });
    </script>
}