<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Circle K</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/Content/site.css" rel="stylesheet" type="text/css" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<style>
    .menu-bordered {
        gap: 15px;
    }

        .menu-bordered .nav-item {
            position: relative;
            padding: 0 15px;
        }

            .menu-bordered .nav-item:not(:last-child)::after {
                content: "";
                position: absolute;
                right: 0;
                top: 30%;
                height: 40%;
                width: 1px;
                background-color: #ccc;
            }
    /* Cố định thanh navbar chính */
    nav.navbar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    .body-content {
        margin-top: 150px; /* nav 70px + submenu 70px (điều chỉnh theo thực tế) */
    }
    .submenu-bar {
        display: flex;
        position: fixed;
        top: 70px; /* chỉnh tùy thuộc chiều cao nav (ví dụ 70px) */
        left: 0;
        width: 100%;
        z-index: 999;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        justify-content: center;
        align-items: center;
        gap: 30px;
        background-color: #66FFCC !important;
        padding: 10px 20px;
    }

    .submenu-bar-footer {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 30px;
        background-color: transparent !important;
        padding: 10px 20px;
    }

    .submenu-bar a {
        color: black !important;
        text-decoration: none;
        position: relative;
        display: block; /* ✅ từ flex -> block */
        padding: 10px 15px; /* ✅ padding đều */
        font-weight: 500;
        transition: background-color 0.3s, color 0.3s;
    }

        .submenu-bar a:not(:last-child)::after {
            content: "";
            width: 1px;
            height: 20px;
            background-color: black;
        }

    .submenu-bar-footer a {
        color: black !important;
        text-decoration: none;
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
    }

        .submenu-bar-footer a:not(:last-child)::after {
            content: "";
            width: 1px;
            height: 20px;
            background-color: black;
            margin-left: 15px;
            display: inline-block;
        }

    /* ===== FULL FOOTER GIAO DIỆN ===== */
    .full-footer {
        background-color: #99FFFF;
        padding-top: 15px;
        font-size: 14px;
        color: #000;
    }
    /* HÀNG 1: LOGO + MENU + TÌM KIẾM */
    .footer-top {
        padding: 0 10px 15px 10px;
        align-items: center;
        gap: 20px;
    }

    .footer-logo img {
        height: 60px;
    }
    /* TÌM KIẾM */
    .footer-search {
        max-width: 300px;
        width: 100%;
    }

        .footer-search .form-control {
            border-left: none;
            border-right: none;
        }

        .footer-search .btn {
            border-radius: 0;
        }

        .footer-search .input-group-text {
            background-color: white;
            border: 1px solid #ced4da;
        }

    /* ĐƯỜNG KẺ NGANG */
    .footer-divider {
        border: none;
        height: 2px;
        background-color: black;
        margin: 0 10px 15px 10px;
    }

    /* THÔNG TIN LIÊN HỆ */
    .footer-info {
        padding: 10px 20px 20px 20px;
    }

    .footer-left,
    .footer-right {
        max-width: 48%;
    }

    .full-footer p {
        margin-bottom: 6px;
        line-height: 1.4;
    }

    .full-footer img {
        margin-top: 10px;
    }

    .footer-nav-links {
        width: 100%;
        justify-content: center; /* Căn giữa khối ul */
        display: flex;
        justify-content: center;
        margin-top: 10px;
    }

        .footer-nav-links ul {
            font-size: 18px; /* ⬅ Tăng cỡ chữ tại đây */
            font-weight: 500; /* (Tuỳ chọn) Làm đậm nhẹ */
            list-style: none;
            padding: 0;
            margin: 0;
            gap: 20px;
        }

        .footer-nav-links li {
            position: relative;
            padding: 0 15px;
        }
    /* === CSS CHO MENU DROPDOWN === */
    .submenu-bar .has-dropdown {
        position: relative;
        display: inline-block;
    }

    .submenu-bar .dropdown-content {
        display: none;
        position: absolute;
        background-color: #66FFCC;
        min-width: 180px;
        box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        z-index: 10;
    }

        .submenu-bar .dropdown-content a {
            display: block;
            padding: 12px 20px;
            color: #2C3E50; /* xanh than dễ đọc trên nền sáng */
            text-decoration: none;
            white-space: nowrap;
            font-weight: 500;
            transition: background-color 0.3s, color 0.3s;
        }

            .submenu-bar .dropdown-content a:hover {
                background-color: #D0ECF8; /* hover nhạt hơn pastel chính */
                color: #E74C3C; /* đỏ nhấn khi hover */
            }

    .submenu-bar .has-dropdown:hover .dropdown-content {
        display: block;
    }
    .cart-button {
        border: 3px solid #FFCC33;
        color: black;
        border-radius: 5px;
        background-color: #FFCC33;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        text-decoration: none;
    }

        /* Hover đổi màu nền và chữ */
        .cart-button:hover {
            border: 3px solid #FFCC33;
            background-color: white;
            color: black;
        }

    .register-button {
        border: 3px solid #33FF66;
        color: black;
        border-radius: 5px;
        background-color: #33FF66;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        text-decoration: none;
    }

        /* Hover đổi màu nền và chữ */
        .register-button:hover {
            border: 3px solid #33FF66;
            background-color: white;
            color: black;
        }

    .login-button {
        border: 3px solid aqua;
        color: black;
        border-radius: 5px;
        background-color: aqua;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        text-decoration: none;
    }

        /* Hover đổi màu nền và chữ */
        .login-button:hover {
            border: 3px solid aqua;
            background-color: white;
            color: black;
        }
</style>
@*-------------------------------------------------------------------------------------------------------------------------------------------*@
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-sm navbar-dark" style="background-color: #ffff;">
        <div class="container d-flex justify-content-between align-items-center w-100">

            <!-- PHẦN TRÁI: LOGO -->
            <div class="d-flex align-items-center">
                @Html.Raw("<a href='" + Url.Action("Index", "Home") + "' class='navbar-brand'><img src='/Content/Images/logo.png' alt='Circle K Logo' style='height: 50px;' /></a>")

                <!-- Toggle button (hiện ở mobile) -->
                <button type="button" class="navbar-toggler ms-2" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <!-- PHẦN GIỮA: MENU -->
            <div class="collapse navbar-collapse justify-content-center" id="mainNavbar">
                <ul class="navbar-nav menu-bordered d-flex flex-row">
                    <li class="nav-item">
                        @Html.ActionLink("Giới Thiệu", "GioiThieu", "GioiThieu", null, new { @class = "nav-link text-dark" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Liên Hệ", "LienHe", "LienHe", null, new { @class = "nav-link text-dark" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Chính Sách Bảo Mật", "ChinhSach", "ChinhSach", null, new { @class = "nav-link text-dark" })
                    </li>
                </ul>
            </div>

            <!-- PHẦN PHẢI: NÚT -->
            <!-- PHẦN PHẢI: NÚT -->
            <div class="d-flex align-items-center">
                <ul class="navbar-nav flex-row">
                    <li class="nav-item">
                        <a href="@Url.Action("Cart", "GioHang")" class="nav-link btn mx-1 cart-button">
                            <img src="~/Content/Images/cart.png" alt="Cart" width="20" height="20" style="margin-right: 5px;" />
                            Giỏ Hàng
                        </a>
                    </li>

                    @if (Session["UserName"] != null)
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("NguoiDung", "Account")" class="nav-link btn mx-1" style="border: 1px solid #28a745; color: #28a745; border-radius: 5px;">
                                <i class="fa fa-user"></i> @Session["UserName"]
                            </a>
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Đăng Xuất", "Logout", "Account", null, new
                            {
                                @class = "nav-link btn mx-1",
                                style = "border: 1px solid #dc3545; color: #dc3545; border-radius: 5px;"
                            })
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Đăng Ký", "Register", "Account", null, new
                            {
                                @class = "nav-link btn mx-1 register-button",
                            })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Đăng Nhập", "Login", "Account", null, new
                            {
                                @class = "nav-link btn mx-1 login-button",
                            })
                        </li>
                    }
                </ul>
            </div>
</nav>


    <!-- MENU PHỤ CÓ ICON + ĐƯỜNG KẺ NGĂN -->
    <div class="submenu-bar">
        <a href="#"><i class="fas fa-store-alt"></i> Hệ Thống Circle K</a>
        <a href="@Url.Action("UuDai", "UuDai")"><i class="fas fa-gift"></i> Ưu Đãi Đặc Biệt</a>
        <div class="has-dropdown">
            <a href="#">
                <i class="fa fa-utensils"></i> Thức Ăn & Thức Uống
            </a>
            <div class="dropdown-content">
                <a href="@Url.Action("DoAn", "DoAn")">Thức Ăn</a>
                <a href="@Url.Action("DoUong", "DoUong")">Thức Uống</a>
            </div>
        </div>

        <!-- Kết thúc phần sửa -->
        <a href="#"><i class="fas fa-box-open"></i> Sản Phẩm & Dịch Vụ</a>
    </div>

    <!-- PHẦN NỘI DUNG TRANG -->
    <div class="container body-content">
        @RenderBody()
        <hr />
    </div>

    <!-- FOOTER -->
    <footer class="full-footer mt-auto">
        <!-- HÀNG 1: LOGO + MENU PHỤ -->
        <div class="footer-top container d-flex justify-content-between align-items-center flex-wrap">
            <!-- Logo -->
            <div class="footer-logo">
                <img src="~/Content/Images/footer-icon.png" alt="Circle K Logo" width="250" />
            </div>

            <!-- Menu phụ -->
            <div class="submenu-bar-footer">
                <a href="#"> Hệ Thống Circle K</a>
                <a href="@Url.Action("UuDai", "UuDai")"> Ưu Đãi Đặc Biệt</a>
                <a href="#"> Thức Ăn & Thức Uống</a>
                <a href="#"> Sản Phẩm & Dịch Vụ</a>
            </div>

            <!-- Ô tìm kiếm -->
            <form class="footer-search d-flex" action="/Search/Results" method="get">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="query" class="form-control" placeholder="Tìm kiếm..." />
                    <button class="btn btn-outline-dark" type="submit">Tìm Kiếm</button>
                </div>
            </form>
            <div class="footer-nav-links">
                <ul class="d-flex flex-row justify-content-center gap-4">
                    <li>
                        @Html.ActionLink("Giới Thiệu", "GioiThieu", "GioiThieu", null, new { @class = "nav-link text-dark" })
                    </li>
                    <li>
                        @Html.ActionLink("Liên Hệ", "LienHe", "LienHe", null, new { @class = "nav-link text-dark" })
                    </li>
                    <li>
                        @Html.ActionLink("Chính Sách Bảo Mật", "ChinhSach", "ChinhSach", null, new { @class = "nav-link text-dark" })
                    </li>
                </ul>
            </div>
        </div>
        <!-- ĐƯỜNG KẺ NGANG -->
        <hr class="footer-divider" />

        <!-- HÀNG 2: THÔNG TIN LIÊN HỆ -->
        <div class="container d-flex justify-content-between flex-wrap footer-info">
            <div class="footer-left">
                <p><strong>Circle K Vietnam Chuỗi cửa hàng tiện lợi</strong> - Mở cửa 24/7</p>
                <p>Copyright © 2016 Circle K Vietnam</p>
                <p>Tel: +84 (28) 3620 9017</p>
                <p>Email: info@circlek.com.vn</p>
            </div>
            <div class="footer-right">
                <p><strong>CÔNG TY TNHH VÒNG TRÒN ĐỎ</strong> - Giấy CNĐKDN : 0306182043</p>
                <p>Ngày cấp : 10/11/2008. Nơi cấp : Sở Kế Hoạch - Đầu Tư Tp. Hồ Chí Minh</p>
                <p>Địa chỉ : 160 Bùi Thị Xuân, Phường Phạm Ngũ Lão, Quận 1, Tp.Hồ Chí Minh, Việt Nam.</p>
            </div>
        </div>
    </footer>
    <!-- SCRIPT -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
