<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin - @ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/Content/site.css" rel="stylesheet" type="text/css" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- HEADER ADMIN -->
    <header style="background-color: #222; color: white; padding: 10px;">
        <h2>Khu vực quản trị</h2>
        <nav>
            <ul style="list-style: none; display: flex; gap: 15px;">
                <li>@Html.ActionLink("Quản lý sản phẩm", "Index", "Products")</li>
                <li>@Html.ActionLink("Quản lý loại sản phẩm", "Index", "Categories")</li>
                <li>@Html.ActionLink("Đăng xuất", "Logout", "Account")</li>
            </ul>
        </nav>
    </header>

    <!-- NỘI DUNG CHÍNH -->
    <main style="padding: 20px;">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer style="background-color: #222; color: white; text-align: center; padding: 10px;">
        <p>&copy; @DateTime.Now.Year - Trang quản trị</p>
    </footer>
</body>
</html>
