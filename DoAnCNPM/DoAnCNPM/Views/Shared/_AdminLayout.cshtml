<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin - @ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/Content/site.css" rel="stylesheet" type="text/css" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        header nav ul {
            list-style: none;
            display: flex;
            gap: 15px;
            padding-left: 0;
            justify-content: center; /* ✅ Canh giữa các li */
        }

            header nav ul li {
                padding: 5px 12px;
                background-color: #333;
                border-radius: 5px;
                transition: background-color 0.3s, color 0.3s;
            }

                header nav ul li a {
                    color: white;
                    text-decoration: none;
                    display: block;
                }

                header nav ul li:hover {
                    background-color: white;
                }

                    header nav ul li:hover a {
                        color: black;
                    }

        /* Đặc biệt cho nút Đăng xuất */
        .logout {
            background-color: #aa2e25;
        }

            .logout:hover {
                background-color: #ff4d4d;
            }

                .logout:hover a {
                    color: white;
                }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- HEADER ADMIN -->
    <header style="background-color: #222; color: white; padding: 10px;">
        <h2>Khu vực quản trị</h2>
        <nav>
            <ul style="list-style: none; display: flex; gap: 15px;">
                <li>@Html.ActionLink("Thống kê doanh thu", "RevenueByMonth", "Report")</li>
                <li>@Html.ActionLink("Quản lý sản phẩm", "Index", "Products")</li>
                <li>@Html.ActionLink("Quản lý loại sản phẩm", "Index", "Categories")</li>
                <li>@Html.ActionLink("Quản lý khuyến mãi", "Index", "UuDai")</li>
                <li>@Html.ActionLink("Chi tiết đơn hàng", "Index", "OrderDetails")</li>
                <li>@Html.ActionLink("Danh sách đơn hàng", "Index", "OrderProes")</li>
                <li>@Html.ActionLink("Danh sách khách hàng", "Index", "Customers")</li>
                <li class="logout">@Html.ActionLink("Đăng xuất", "Logout", "Account")</li>
            </ul>
        </nav>
    </header>

    <!-- NỘI DUNG CHÍNH -->
    <main class="flex-fill" style="padding: 20px;">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="mt-auto" style="background-color: #222; color: white; text-align: center; padding: 10px;">
        <p>&copy; @DateTime.Now.Year - Trang quản trị</p>
    </footer>
    <!-- BỔ SUNG: Để tránh lỗi thiếu Scripts section -->
    @RenderSection("Scripts", required: false)
</body>
</html>
