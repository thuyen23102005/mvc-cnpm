@model IEnumerable<DoAnCNPM.Models.Product>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>DANH MỤC SẢN PHẨM</h2>

<p>
    @Html.ActionLink("Thêm sản phẩm mới", "Create")
</p>
<table class="table table-bordered" style="border-width:thick">
    <tr>
        <th> Tên Sản phẩm </th>
        <th> Mô tả </th>
        <th> Đơn giá </th>
        <th> Hình </th>
        <th> Loại Sản phẩm </th>
        <th></th>
    </tr>
    @if (Model != null)
    {
         foreach (var item in Model)
         {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NamePro)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DecriptionPro)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImagePro))
                    {
                        <img src="@Url.Content(item.ImagePro)" width="60" alt="Hình ảnh" />
                    }
                    else
                    {
                        <span>Không có ảnh</span>
                    }
                </td>
                <td>
                    @(item.Category != null ? item.Category.NameCate : "Chưa phân loại")
                </td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID })
                </td>
            </tr>
         }
    }
    else
    {
        <tr>
            <td colspan="6" class="text-center">Không có dữ liệu sản phẩm để hiển thị.</td>
        </tr>
    }
</table>
