@model DoAnCNPM.Models.Product

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>CẬP NHẬT SẢN PHẨM</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.ProductID)

    <div class="form-group" style="display: flex; align-items: center; margin-bottom: 15px;">
        <label style="width: 150px; font-weight: bold;">Tên Sản Phẩm:</label>
        @Html.EditorFor(model => model.NamePro, new { htmlAttributes = new { @class = "form-control", style = "flex: 1;" } })
    </div>

    <div class="form-group" style="display: flex; align-items: center; margin-bottom: 15px;">
        <label style="width: 150px; font-weight: bold;">Mô tả:</label>
        @Html.EditorFor(model => model.DecriptionPro, new { htmlAttributes = new { @class = "form-control", style = "flex: 1;" } })
    </div>

    <div class="form-group" style="display: flex; align-items: center; margin-bottom: 15px;">
        <label style="width: 150px; font-weight: bold;">Loại SP:</label>
        @Html.DropDownList("CateID", null, htmlAttributes: new { @class = "form-control", style = "flex: 1;" })
    </div>

    <div class="form-group" style="display: flex; align-items: center; margin-bottom: 15px;">
        <label style="width: 150px; font-weight: bold;">Đơn giá:</label>
        @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control", style = "flex: 1;" } })
    </div>

    <!-- Dòng label + input -->
    <div class="form-group" style="display: flex; align-items: center; margin-bottom: 5px;">
        <label style="width: 150px; font-weight: bold;">Hình:</label>
        @Html.TextBoxFor(model => model.ImagePro, null, new { type = "file", @class = "form-control", style = "flex: 1;" })
    </div>

    <!-- Dòng ảnh riêng bên dưới -->
    <div class="form-group" style="margin-left: 150px; margin-bottom: 15px;">
        <img src="~/Content/Images/@Model.ImagePro" width="200" height="200" />
        @Html.ValidationMessageFor(model => model.ImagePro, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Cập nhật" class="btn btn-primary" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Quay lại", "Index")
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
