@model DoAnCNPM.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4 text-danger">XÓA SẢN PHẨM</h2>

<div class="alert alert-warning" role="alert">
    <strong>Bạn có chắc chắn muốn xóa sản phẩm này không?</strong> Hành động này không thể hoàn tác.
</div>

<div class="card shadow-sm p-4 mb-4 bg-light rounded">
    <div class="row mb-3">
        <div class="col-sm-3 fw-bold">Tên sản phẩm:</div>
        <div class="col-sm-9">@Html.DisplayFor(model => model.NamePro)</div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-3 fw-bold">Mô tả:</div>
        <div class="col-sm-9">@Html.DisplayFor(model => model.DecriptionPro)</div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-3 fw-bold">Đơn giá:</div>
        <div class="col-sm-9">@Html.DisplayFor(model => model.Price)</div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-3 fw-bold">Hình:</div>
        <div class="col-sm-9">
            <div>@Html.DisplayFor(model => model.ImagePro)</div>
            <img src="~/Content/Images/@Model.ImagePro" class="img-thumbnail mt-2" width="200" height="200" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-3 fw-bold">Loại sản phẩm:</div>
        <div class="col-sm-9">@Html.DisplayFor(model => model.Category.NameCate)</div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="mt-3">
        <input type="submit" value="Xác nhận xóa" class="btn btn-danger me-2" />
        @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}
