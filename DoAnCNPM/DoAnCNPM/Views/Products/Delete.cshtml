@model DoAnCNPM.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>XÓA SẢN PHẨM</h2>

<h4>Bạn có chắc chắn muốn xóa sản phẩm này không?</h4>
<hr />

<!-- Tên sản phẩm -->
<div class="form-group" style="display: flex; align-items: center; margin-bottom: 15px;">
    <label style="width: 150px; font-weight: bold;">Tên sản phẩm:</label>
    <span>@Html.DisplayFor(model => model.NamePro)</span>
</div>

<!-- Mô tả -->
<div class="form-group" style="display: flex; align-items: center; margin-bottom: 15px;">
    <label style="width: 150px; font-weight: bold;">Mô tả:</label>
    <span>@Html.DisplayFor(model => model.DecriptionPro)</span>
</div>

<!-- Đơn giá -->
<div class="form-group" style="display: flex; align-items: center; margin-bottom: 15px;">
    <label style="width: 150px; font-weight: bold;">Đơn giá:</label>
    <span>@Html.DisplayFor(model => model.Price)</span>
</div>

<!-- Hình ảnh: label + ảnh bên dưới -->
<div class="form-group" style="display: flex; align-items: center; margin-bottom: 5px;">
    <label style="width: 150px; font-weight: bold;">Hình:</label>
    <span>@Html.DisplayFor(model => model.ImagePro)</span>
</div>
<div class="form-group" style="margin-left: 150px; margin-bottom: 15px;">
    <img src="~/Content/Images/@Model.ImagePro" width="200" height="200" />
</div>

<!-- Loại sản phẩm -->
<div class="form-group" style="display: flex; align-items: center; margin-bottom: 15px;">
    <label style="width: 150px; font-weight: bold;">Loại sản phẩm:</label>
    <span>@Html.DisplayFor(model => model.Category.NameCate)</span>
</div>

<!-- Nút xác nhận xóa -->
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-actions">
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        @Html.ActionLink("Quay lại danh sách", "Index")
    </div>
}

