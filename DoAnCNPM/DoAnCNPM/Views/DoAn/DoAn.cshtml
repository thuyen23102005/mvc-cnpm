@model  List<DoAnCNPM.Models.Product>
@{
    ViewBag.Title = "Thức ăn Circle K";
    Layout = "~/Views/Shared/_Layout.cshtml"; // dùng layout chung
}

<style>
    .tab-bar {
        text-align: center;
        margin: 20px 0;
    }

        .tab-bar button {
            margin: 5px;
            padding: 10px 20px;
            background: #eee;
            border: 1px solid #ccc;
            cursor: pointer;
        }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        padding: 20px;
        justify-items: center;
    }

    .product-card {
        text-align: center;
    }

        .product-card img {
            width: 180px;
            height: auto;
            border-radius: 10px;
        }

    .product-name {
        margin-top: 10px;
        font-weight: bold;
    }

    .explore {
        text-align: center;
        font-size: 20px;
        color: green;
        margin: 30px;
    }

    .tab-bar button.active {
        background-color: #28a745;
        color: white;
        font-weight: bold;
        border: 2px solid #1e7e34;
    }
</style>

<!-- Menu danh mục -->
<div class="tab-bar">
    <button onclick="locDanhMuc('Tất Cả')" data-danhmuc="Tất Cả">TẤT CẢ THỨC ĂN</button>
    <button onclick="locDanhMuc('Mì')" data-danhmuc="Mì">MÌ</button>
    <button onclick="locDanhMuc('Bánh Mì')" data-danhmuc="Bánh Mì">BÁNH MÌ</button>
    <button onclick="locDanhMuc('Bánh Bao')" data-danhmuc="Bánh Bao">BÁNH BAO</button>
    <button onclick="locDanhMuc('Xôi')" data-danhmuc="Xoi">XÔI</button>
    <button onclick="locDanhMuc('Tráng Miệng')" data-danhmuc="Tráng Miệng">TRÁNG MIỆNG</button>
</div>

<!-- Danh sách món ăn -->
<div class="product-grid" id="grid-do-an">
    @foreach (var item in Model)
    {
        <div class="product-card" data-danhmuc="@item.Category.NameCate">
            @{
                var imagePath = string.IsNullOrEmpty(item.ImagePro)
                    ? "~/Content/Images/Banana.png"
                    : "~/Content/Images/" + item.ImagePro;
            }
            <img src="@Url.Content(imagePath)" alt="@item.NamePro"
                 onclick="showPopup('@item.ProductID', '@item.NamePro', '@Url.Content(imagePath)', '@item.Category.NameCate', '@item.Price', '@item.DecriptionPro')" />
            <div class="product-name">@item.NamePro</div>
        </div>
    }
</div>

<!-- POPUP CHI TIẾT SẢN PHẨM -->
<div id="popup" style="display:none; position:fixed; top:10%; left:50%; transform:translateX(-50%); background:#fff; padding:20px; border:1px solid #ccc; z-index:1000; border-radius:10px; width:300px;">
    <span style="float:right; cursor:pointer; font-size:18px;" onclick="closePopup()">❌</span>
    <img id="popup-img" src="" style="width:100%; border-radius:10px;" />
    <h3 id="popup-name" style="margin-top:10px;"></h3>
    <p><b>Danh mục:</b> <span id="popup-category"></span></p>
    <p><b>Mô tả:</b> <span id="popup-desc"></span></p>
    <p><b>Giá:</b> <span id="popup-price"></span> VND</p>

    <input type="hidden" id="popup-id" value="" />

    <div style="margin:10px 0;">
        <label>Số lượng:</label>
        <input type="number" id="popup-qty" value="1" min="1" style="width:60px;" />
    </div>
    <button onclick="themVaoGioHang()" style="background-color:#28a745; color:white; padding:8px 16px; border:none; border-radius:5px;">
        🛒 Thêm vào giỏ hàng
    </button>
</div>

<!-- NỀN LÀM MỜ KHI POPUP HIỆN -->
<div id="popup-bg" onclick="closePopup()" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.3); z-index:999;"></div>

<script src="~/Scripts/popup.js"></script>
<script src="~/Scripts/loc.js"></script>