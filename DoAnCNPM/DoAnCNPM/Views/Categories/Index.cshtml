@model IEnumerable<DoAnCNPM.Models.Category>

@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>DANH MỤC LOẠI SẢN PHẨM</h2>

<p>
    @Html.ActionLink("Thêm danh mục", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-bordered" style="border-width: thick; width: 100%;">
    <thead>
        <tr>
            <th style="text-align: left;">Tên danh mục</th>
            <th style="text-align: center;">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NameCate)</td>
                <td style="text-align: center;">
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.IDCate }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.IDCate }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.IDCate })
                </td>
            </tr>
        }
    </tbody>
</table>
