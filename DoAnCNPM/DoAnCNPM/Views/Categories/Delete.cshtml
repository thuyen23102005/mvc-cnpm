@model DoAnCNPM.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4 text-danger">XÓA DANH MỤC</h2>

<div class="alert alert-warning" role="alert">
    <strong>Bạn có chắc chắn muốn xóa danh mục này không?</strong> Hành động này không thể hoàn tác.
</div>

<div class="card shadow-sm p-4 mb-4 bg-light rounded">
    <div class="row mb-3">
        <div class="col-sm-3 fw-bold">
            Tên danh mục:
        </div>
        <div class="col-sm-9">
            @Html.DisplayFor(model => model.NameCate)
        </div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="mt-3">
        <input type="submit" value="Xác nhận xóa" class="btn btn-danger me-2" />
        @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}
